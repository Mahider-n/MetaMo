;; Native frame startup, actual Core handlers; only external services doubled.
!(import! &self (library lib_import))
!(import! &self (library OmegaClaw-Core src/loop))
!(import! &self fixtures/full_loop.metta)
!(import! &self (library MetaMo applications/omegaclaw_v1/runtime_support))
(= (getPrompt) "Inspect only the selected authorized command.")
(= (maxFeedback) 512)
!(import! &self (library MetaMo applications/omegaclaw_v1/host_startup))
!(import! &self fixtures/host_config_fixture.py)
!(import! &self fixtures/host_startup_fixture.py)
!(py-call (host_config_fixture.setup))
!(initContextFrame)
!(fullLoopStartSession)
!(test (py-call (host_startup_fixture.configure)) 1)
!(test (initializeHostStartup) True)
!(change-state! &core-loop-new-message True)
!(test (coreLoopPrepare) 1)
!(test (get-state &new-msg-flag) True)
!(change-state! &core-loop-new-message False)
;; Setup waits without inventing an active frame.
!(test (coreLoopPrepare) 1)
!(test (cfv2-root-current-frame-id) ())
!(ctx-ingest-user-message "Inspect the configured local file")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(bind! &startup-native-id (new-state (cfv2-root-current-frame-id)))
!(test (coreLoopPrepare) 1)
!(test (cfv2-root-current-frame-id) (get-state &startup-native-id))
!(test (get-state &active-task) "Inspect the configured local file")
!(test (get-state &task-open) True)
!(test (size-atom (collapse (coreLoopContext))) 1)
!(test (tpContains (map-atom (get-state &operation-admitted-actions) $a (actionId $a)) search-knowledge) True)
!(setConstitutionalMode Engaged)
!(bind! &startup-read (new-state (sread (py-call (host_config_fixture.command)))))
(= (startupReadTicket)
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame execute-skill)))
(= (startupFrameTicket)
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame search-knowledge)))
!(bind! &startup-ticket (new-state (startupReadTicket)))
;; Repeated preparation must not reinstall policies or invalidate the ticket.
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (get-state &startup-ticket) (get-state &startup-read))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (coreDispatchCommand (startupFrameTicket) (quote (show-current-frame)))
   (DispatchResult Executed Feasible (cfv2-current-frame)))
!(test (py-call (host_startup_fixture.mismatched)) 1)
;; A failed target check leaves the existing valid configuration untouched.
!(test (coreDispatchCommand (startupReadTicket) (get-state &startup-read))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (py-call (host_startup_fixture.configure "permission-denied")) 1)
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (startupReadTicket) (get-state &startup-read))
   (DispatchResult Blocked PermissionDenied none))
!(test (py-call (host_startup_fixture.configure)) 1)
!(test (coreLoopPrepare) 1)
;; Once bound, changing frames cannot retarget startup grants.
!(change-state! &cfv2-current-frame-id AnotherNativeFrame)
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (startupReadTicket) (get-state &startup-read))
   (DispatchResult Blocked TargetMismatch none))
!(py-call (host_config_fixture.cleanup))
