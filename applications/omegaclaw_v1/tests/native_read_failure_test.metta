;; Real native reader: successful empty content is distinct from unavailable input.
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self fixtures/host_config_fixture.py)
!(py-call (host_config_fixture.setup))
!(bind! &native-read (new-state (sread (py-call (host_config_fixture.command)))))
(= (nativeRead) (let $command (get-state &native-read) (eval $command)))
!(test (nativeRead) "observed local file content")
!(test (py-call (host_config_fixture.empty_file)) 1)
!(test (nativeRead) "")
!(test (operationOutcomeStatus (get-state &native-read) (DispatchResult Executed Feasible "")) Success)
!(test (py-call (host_config_fixture.remove_file)) 1)
!(test (== (nativeRead) (quote (Error read-file FileUnavailable))) True)
!(test (operationOutcomeStatus (get-state &native-read)
   (DispatchResult Executed Feasible (Error read-file FileUnavailable))) Failure)
;; Generic exception/partial-execution uncertainty remains distinct from Failure.
!(test (operationOutcomeStatus (get-state &native-read)
   (DispatchResult Unobserved ExecutionUncertain none)) Unobserved)
!(test (py-call (host_config_fixture.replace_file_content)) 1)
!(test (nativeRead) "changed after invocation")
!(test (py-call (host_config_fixture.cleanup)) 1)
